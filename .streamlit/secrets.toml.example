# Copy to .streamlit/secrets.toml on Streamlit Cloud (App settings → Secrets).
# NEVER commit the real file. Local runs use .env instead.
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "you@gmail.com"
SMTP_PASS = "xxxx-xxxx-xxxx-xxxx"
ALERT_TO = "you@gmail.com"
FEEDBACK_TO = "you@gmail.com"
# Optional: Formspree/Basin endpoint so feedback survives cloud restarts
FEEDBACK_ENDPOINT = ""
OPENAI_API_KEY = ""
