# Copy to .env and fill in
# Gmail: HOST=smtp.gmail.com PORT=587 USER=you@gmail.com PASS=<16-char App Password>
# Get App Password: Google Account > Security > 2-Step ON > App passwords > Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_TO=
# Optional LLM for richer coaching (OpenAI-compatible). Leave blank for offline mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional LOCAL open model (free, private, offline). Install Ollama + `ollama pull llama3.1`.
# When reachable, the tutor uses it automatically; otherwise built-in answers apply.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
